@model BlackJack21.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "VIP Access";
}

<style>
    /* VIP Authentication Styling */

</style>

<div class="container d-flex justify-content-center align-items-center mt-5 pt-4">
    <div class="vip-auth-container w-100" style="max-width: 450px;">

        <div class="text-center mb-4">
            <h2 class="vip-auth-title fw-bold">LOGIN</h2>
            <p class="text-secondary small" style="letter-spacing: 1px;">Authenticate to join the tables</p>
        </div>

        <form asp-action="Login" method="post">

            <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-dark border border-danger text-danger py-2 px-3 small rounded-3"></div>

            <div class="form-group mb-4">
                <label asp-for="Email" class="vip-label"></label>
                <input asp-for="Email" class="form-control vip-auth-input" placeholder="Enter your email" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block fw-bold"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Password" class="vip-label"></label>
                <input asp-for="Password" class="form-control vip-auth-input" placeholder="Enter your password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block fw-bold"></span>
            </div>

            <div class="form-group form-check mb-4 d-flex align-items-center">
                <input class="form-check-input me-2 bg-dark border-secondary" asp-for="RememberMe" id="rememberMeCheck" />
                <label class="form-check-label text-light small pt-1" for="rememberMeCheck" style="letter-spacing: 0.5px;">
                    Keep me logged in
                </label>
            </div>

            <div class="form-group mt-5">
                <button type="submit" class="btn btn-gold w-100 py-3 fs-5 shadow-sm">
                    Play
                </button>
            </div>
        </form>

        <div class="text-center mt-4 pt-3 border-top border-secondary">
            <p class="text-muted small mb-0">
                Don't have an account? <a asp-action="Register" class="link-gold fw-bold">Register here</a>
            </p>
        </div>

    </div>
</div>