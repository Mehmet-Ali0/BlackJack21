@using Microsoft.AspNetCore.Identity
@using BlackJack21.Models
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Blackjack 21</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/blackjack.css" asp-append-version="true" />

    <style>
            /* Premium VIP Navbar Styling */
            .vip-navbar {
                background: rgba(12, 12, 12, 0.95); /* Deep dark translucent */
                backdrop-filter: blur(12px); /* Frosted glass effect */
                border-bottom: 1px solid rgba(212, 175, 55, 0.3); /* Subtle gold rim */
            }

            .vip-brand {
                font-family: 'Georgia', serif;
                letter-spacing: 2px;
                font-size: 1.4rem;
            }

            .vip-nav-link {
                letter-spacing: 1px;
                text-transform: uppercase;
                font-size: 0.85rem;
                color: #aaa !important;
                transition: all 0.3s ease;
            }

                .vip-nav-link:hover {
                    color: #d4af37 !important; /* Gold text on hover */
                }

            /* The glowing gold VIP user badge */
            .vip-badge {
                background: linear-gradient(145deg, #d4af37 0%, #aa8c2c 100%);
                color: #000;
                font-weight: 800;
                letter-spacing: 1px;
                border: 1px solid #ffdf00;
                box-shadow: 0 4px 10px rgba(212, 175, 55, 0.2);
            }

            /* Standardized button hover animations */
            .nav-btn {
                text-transform: uppercase;
                letter-spacing: 1px;
                font-weight: 700;
                font-size: 0.85rem;
                transition: all 0.2s ease-in-out;
            }

                .nav-btn:hover {
                    transform: translateY(-2px);
                }
    </style>
</head>
<body class="blackjack-theme">

    <nav class="navbar navbar-expand-sm navbar-dark vip-navbar shadow-lg mb-4 py-3">
        <div class="container">
            <a class="navbar-brand fw-bold vip-brand text-light" asp-controller="BlackJack" asp-action="Index">
                <span class="text-danger">♥</span> Blackjack <span style="color: #d4af37;">21</span> <span class="text-danger">♥</span>
            </a>

            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav ms-auto align-items-center">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item me-4 mb-2 mb-sm-0">
                            <span class="badge vip-badge rounded-pill px-4 py-2 fs-6">
                                User: @User.Identity?.Name
                            </span>
                        </li>
                        <li class="nav-item">
                            <form class="form-inline m-0" asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-outline-danger nav-btn rounded-pill px-4 py-2">
                                    Logout
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item me-2">
                            <a class="nav-link vip-nav-link fw-bold px-3" asp-controller="Account" asp-action="Register">Register</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn nav-btn rounded-pill px-4 py-2" style="background-color: #d4af37; color: #000;" asp-controller="Account" asp-action="Login">
                                Login
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div>
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>