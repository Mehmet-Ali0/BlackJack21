@using Microsoft.AspNetCore.Identity
@using BlackJack21.Models
@model List<ApplicationUser>
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = "Casino Lobby";
}

<style>
    /* VIP Dashboard Styling */
    .lobby-container {
        background: rgba(15, 15, 15, 0.85);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(212, 175, 55, 0.25);
        border-radius: 16px;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.8);
        padding: 2.5rem;
    }

    .vip-title {
        color: #fff;
        font-family: 'Georgia', serif;
        letter-spacing: 3px;
    }

    .gold-text {
        color: #d4af37;
    }

    /* Glass Cards */
    .lobby-card {
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        padding: 1.5rem;
    }

    /* Table & Leaderboard */
    .vip-table {
        color: #fff !important;
        vertical-align: middle;
    }

        .vip-table th {
            color: #d4af37 !important;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 1px;
        }

        .vip-table td {
            border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
            font-size: 0.9rem;
        }

    /* Premium Wager Input */
    .vip-input {
        background-color: rgba(0, 0, 0, 0.6) !important;
        border: 1px solid rgba(212, 175, 55, 0.3) !important;
        color: #fff !important;
        font-weight: bold;
    }

        .vip-input:focus {
            border-color: #d4af37 !important;
            box-shadow: 0 0 10px rgba(212, 175, 55, 0.2) !important;
        }

    .vip-addon {
        background-color: #d4af37 !important;
        border: 1px solid #d4af37 !important;
        color: #000 !important;
    }

    /* Deal Button */
    .btn-deal {
        background: linear-gradient(145deg, #28a745 0%, #1e7e34 100%);
        color: #fff;
        font-weight: 800;
        letter-spacing: 1.5px;
        border: 1px solid #28a745;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

        .btn-deal:hover {
            background: linear-gradient(145deg, #218838 0%, #1c7430 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(40, 167, 69, 0.3);
            color: #fff;
        }

    /* Filter Buttons */
    .btn-filter {
        border: 1px solid rgba(212, 175, 55, 0.4);
        color: #d4af37;
        background: transparent;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
        transition: all 0.2s;
    }

        .btn-filter:hover {
            background: #d4af37;
            color: #000;
        }

    .login-btn {
        background: linear-gradient(145deg, #d4af37 0%, #aa8c2c 100%);
        color: #000;
        font-weight: 700;
        letter-spacing: 1px;
    }

        .login-btn:hover {
            color: #000;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
        }
</style>

<div class="container mt-5">
    <div class="lobby-container">

       

        @if (SignInManager.IsSignedIn(User))
        {
            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="lobby-card h-100 d-flex flex-column justify-content-center py-4">
                        <h4 class="gold-text mb-4 text-uppercase text-center" style="letter-spacing: 1px; font-size: 1.1rem;">Place Your Bet</h4>

                        <form action="/BlackJack/Start" method="post" class="w-100 px-2">
                            <div class="mb-4">
                                <label class="text-muted mb-2 text-uppercase small" style="letter-spacing: 1px;">Wager Amount</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text vip-addon">🪙</span>
                                    <input type="number" name="Bet" class="form-control vip-input text-center" value="50" min="10" step="10" required />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-deal w-100 py-3 fs-5 text-uppercase shadow-sm">
                                🃏 Deal Hand
                            </button>
                        </form>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="lobby-card">
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center mb-3 gap-2">
                            <h4 class="text-light m-0 text-uppercase" style="letter-spacing: 1px; font-size: 1.1rem;">🏆 Leaderboard</h4>

                            <form asp-action="Index" asp-controller="BlackJack" method="get" class="m-0">
                                <div class="btn-group" role="group">
                                    <button asp-route-order="1" type="submit" class="btn btn-filter btn-sm rounded-start">Net Gain</button>
                                    <button asp-route-order="2" type="submit" class="btn btn-filter btn-sm">Won</button>
                                    <button asp-route-order="3" type="submit" class="btn btn-filter btn-sm rounded-end">Lost</button>
                                </div>
                            </form>
                        </div>

                        <div class="table-responsive">
                            <table id="leaderboard" class="table vip-table m-0" style="--bs-table-bg: transparent !important; --bs-table-color: #fff !important;">
                                <thead>
                                    <tr>
                                        <th style="border-bottom: 2px solid rgba(212, 175, 55, 0.3) !important;">Player</th>
                                        <th class="text-end text-success" style="border-bottom: 2px solid rgba(212, 175, 55, 0.3) !important;">Won</th>
                                        <th class="text-end text-danger" style="border-bottom: 2px solid rgba(212, 175, 55, 0.3) !important;">Lost</th>
                                        <th class="text-end gold-text" style="border-bottom: 2px solid rgba(212, 175, 55, 0.3) !important;">Net Gain</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Model)
                                    {
                                        // 1. Calculate the safe values
                                        var won = user.TotalMoneyWon ?? 0;
                                        var lost = user.TotalMoneyLost ?? 0;
                                        var net = won - lost;

                                        <tr style="--bs-table-bg: transparent !important;">
                                            <td class="fw-bold text-light py-3">👤 @user.UserName</td>

                                            <td class="text-end text-success font-monospace py-3">🪙 @won</td>

                                            <td class="text-end text-danger font-monospace py-3">🪙 @lost</td>

                                            <td class="text-end fw-bold font-monospace py-3 @(net >= 0 ? "text-success" : "text-danger")">
                                                🪙 @net
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <p class="text-secondary mb-4">You must be authenticated to join the high-stakes tables and track your stats.</p>
                <div class="mx-auto" style="max-width: 300px;">
                    <a asp-controller="Account" asp-action="Login" class="btn login-btn w-100 py-3 text-uppercase rounded-3">
                        Authenticate to Play
                    </a>
                </div>
            </div>
        }
    </div>
</div>