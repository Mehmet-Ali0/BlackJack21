@using Microsoft.AspNetCore.Identity
@using BlackJack21.Models
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = "Welcome to Blackjack";
}

<div class="text-center mt-5 py-5">
    <h1 class="display-3 font-weight-bold text-success mb-3">Blackjack 21</h1>
    <p class="lead text-light mb-5">Test your strategy against the dealer.</p>

    @if (SignInManager.IsSignedIn(User))
    {
        <form action="/BlackJack/Start" method="post">
            <button type="submit" class="btn btn-success btn-lg px-5 py-3 fs-3 shadow-lg rounded-pill animate-bounce">
                Start New Game
            </button>
        </form>
    }
    else
    {
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-5 py-3 fs-3 shadow-lg rounded-pill">
            Login to Play
        </a>
    }
</div>