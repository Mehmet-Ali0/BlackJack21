@using BlackJack21.ViewModels
@model GameViewModel

@{
    ViewData["Title"] = "Blackjack Table";

    var gameResult = TempData["GameResult"]?.ToString();
    bool isGameOver = !string.IsNullOrEmpty(gameResult);

    // Find the hand we are currently playing to check if we can split
    var activeHand = Model.playerhands.FirstOrDefault(h => h.Id == Model.ActiveHandId);
    bool canSplit = activeHand != null &&
                    activeHand.Cards.Count == 2 &&
                    activeHand.Cards[0].Rank == activeHand.Cards[1].Rank;
}

<!-- Hidden Form for Action Routing -->
<form id="BlackJackForm" method="post"></form>

<div class="container py-4">

    <!-- Header & HUD -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary">
        <div>
            <h1 class="fw-bold text-light mb-0" style="letter-spacing: 1px;">
                <span class="text-danger">♥</span> Blackjack <span class="text-warning">21</span> <span class="text-danger">♦</span>
            </h1>
            <span class="text-muted small fw-bold">GAME ID: #@Model.GameId</span>
        </div>

        <div class="bg-dark border border-2 border-warning rounded px-4 py-2 shadow-sm">
            <h3 class="fw-bold text-warning mb-0">Balance: <span class="text-white">@Model.Balance</span></h3>
        </div>
    </div>

    <!-- Game Result Banner -->
    @if (isGameOver)
    {
        <div class="alert bg-dark text-white text-center fs-3 fw-bold mb-4 shadow-lg border border-2 border-warning" style="letter-spacing: 1px;">
            @gameResult
        </div>
    }

    <div class="blackjack-table shadow-lg rounded-3 p-2">

        <!-- Dealer's Area -->
        <div class="mb-5 px-3">
            <h4 class="mb-3 text-light text-uppercase fw-bold fs-6 tracking-wide">
                <span class="badge bg-danger me-2 shadow-sm">Dealer</span> Hand
            </h4>
            <div class="hand-container d-flex flex-wrap gap-2">
                @for (int i = 0; i < Model.dealerhand.Cards.Count; i++)
                {
                    var card = Model.dealerhand.Cards[i];

                    if (i == 0 || isGameOver)
                    {
                        var isRed = card.Suit == "Hearts" || card.Suit == "Diamonds";
                        var suitSymbol = card.Suit == "Hearts" ? "♥" : card.Suit == "Diamonds" ? "♦" : card.Suit == "Clubs" ? "♣" : "♠";

                        <div class="playing-card shadow-sm @(isRed ? "red" : "black")">
                            <div class="fw-bold fs-5 text-start">@card.Rank</div>
                            <div class="suit-large">@suitSymbol</div>
                            <div class="fw-bold fs-5 text-end rotate-180">@card.Rank</div>
                        </div>
                    }
                    else
                    {
                        <div class="playing-card hidden shadow-sm bg-secondary border border-2 border-dark d-flex justify-content-center align-items-center">
                            <div class="fs-1 fw-bold text-dark opacity-25">♠</div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Player's Area -->
        <div class="mb-4">
            <div class="row g-4">
                @for (int i = 0; i < Model.playerhands.Count; i++)
                {
                    var hand = Model.playerhands[i];
                    bool isActive = hand.Id == Model.ActiveHandId && !isGameOver;

                    <div class="col-md-6">
                        <div class="p-3 rounded h-100 @(isActive ? "border border-3 border-warning shadow-lg bg-dark" : "bg-dark bg-opacity-50 opacity-50")" style="transition: all 0.3s ease;">

                            <h4 class="mb-3 text-light text-uppercase fw-bold fs-6">
                                <span class="badge @(isActive ? "bg-warning text-dark shadow-sm" : "bg-primary") me-2">Hand @(i + 1)</span>
                                @if (isActive)
                                {
                                    <span class="text-warning small animate-pulse">⬅ Your Turn</span>
                                }
                            </h4>

                            <div class="hand-container d-flex flex-wrap gap-2">
                                @foreach (var card in hand.Cards)
                                {
                                    var isRed = card.Suit == "Hearts" || card.Suit == "Diamonds";
                                    var suitSymbol = card.Suit == "Hearts" ? "♥" : card.Suit == "Diamonds" ? "♦" : card.Suit == "Clubs" ? "♣" : "♠";

                                    <div class="playing-card shadow-sm @(isRed ? "red" : "black")">
                                        <div class="fw-bold fs-5 text-start">@card.Rank</div>
                                        <div class="suit-large">@suitSymbol</div>
                                        <div class="fw-bold fs-5 text-end rotate-180">@card.Rank</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>

    <!-- Action Panel -->
    <div class="row justify-content-center mt-5">
        <div class="col-md-8 action-panel text-center">

            <input type="hidden" name="Bet" value="@Model.Bet" form="BlackJackForm" />

            <div class="d-flex justify-content-center gap-3">
                @if (!isGameOver)
                {
                    <button formaction="/BlackJack/Hit/@Model.GameId" form="BlackJackForm" type="submit" class="btn btn-warning btn-lg px-5 fw-bold rounded-pill text-dark shadow">
                        💥 Hit
                    </button>

                    <button formaction="/BlackJack/Stand/@Model.GameId" form="BlackJackForm" type="submit" class="btn btn-danger btn-lg px-5 fw-bold rounded-pill shadow">
                        🛑 Stand
                    </button>

                    @if (canSplit)
                    {
                        <button formaction="/BlackJack/Split/@Model.GameId" form="BlackJackForm" type="submit" class="btn btn-info btn-lg px-4 fw-bold rounded-pill text-dark shadow border border-light">
                            ✂️ Split
                        </button>
                    }
                }
                else
                {
                    <button formaction="/BlackJack/Start" form="BlackJackForm" type="submit" class="btn btn-success btn-lg px-5 py-3 fs-4 fw-bold rounded-pill shadow-lg border border-light">
                        🔄 Play Again
                    </button>
                }
            </div>
        </div>
    </div>
</div>