@using BlackJack21.ViewModels
@model GameViewModel

@{
    ViewData["Title"] = "Blackjack Table";

    var gameResult = TempData["GameResult"]?.ToString();
    bool isGameOver = !string.IsNullOrEmpty(gameResult);

    // Find the hand we are currently playing to check if we can split
    var activeHand = Model.playerhands.FirstOrDefault(h => h.Id == Model.ActiveHandId);
    bool canSplit = activeHand != null &&
                    activeHand.Cards.Count == 2 &&
                    activeHand.Cards[0].Rank == activeHand.Cards[1].Rank;
}

<div class="container py-4">
    
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary">
        <h1 class="fw-bold text-warning mb-0">♣ Blackjack 21 ♦</h1>
        @*Add Chips here*@
        <h1 class="fw-bold text-warning mb-0">Balance: @Model.Balance</h1>    
        <span class="badge bg-dark fs-6 border border-secondary">Game ID: #@Model.GameId</span>
    </div>

    @if (isGameOver)
    {
        <div class="alert alert-info text-center fs-3 fw-bold mb-4 shadow border border-info">
            @gameResult
        </div>
    }

    <div class="blackjack-table shadow-lg">

        <div class="mb-5">
            <h4 class="mb-3 text-light"><span class="badge bg-danger me-2">Dealer</span> Dealer's Hand</h4>
            <div class="hand-container">
                @for (int i = 0; i < Model.dealerhand.Cards.Count; i++)
                {
                    var card = Model.dealerhand.Cards[i];

                    if (i == 0 || isGameOver)
                    {
                        var isRed = card.Suit == "Hearts" || card.Suit == "Diamonds";
                        var suitSymbol = card.Suit == "Hearts" ? "♥" : card.Suit == "Diamonds" ? "♦" : card.Suit == "Clubs" ? "♣" : "♠";

                        <div class="playing-card @(isRed ? "red" : "black")">
                            <div class="fw-bold fs-5 text-start">@card.Rank</div>
                            <div class="suit-large">@suitSymbol</div>
                            <div class="fw-bold fs-5 text-end rotate-180">@card.Rank</div>
                        </div>
                    }
                    else
                    {
                        <div class="playing-card hidden">
                            <div class="fs-1 fw-bold opacity-50">?</div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="mb-4">
            <div class="row">
                @for (int i = 0; i < Model.playerhands.Count; i++)
                {
                    var hand = Model.playerhands[i];
                    bool isActive = hand.Id == Model.ActiveHandId && !isGameOver;

                    <div class="col-md-6 mb-4">
                        <div class="p-3 rounded @(isActive ? "border border-3 border-warning shadow-lg bg-dark" : "opacity-75")">

                            <h4 class="mb-3 text-light">
                                <span class="badge @(isActive ? "bg-warning text-dark" : "bg-primary") me-2">Hand @(i + 1)</span>
                                @(isActive ? "⬅ Your Turn" : "")
                            </h4>

                            <div class="hand-container">
                                @foreach (var card in hand.Cards)
                                {
                                    var isRed = card.Suit == "Hearts" || card.Suit == "Diamonds";
                                    var suitSymbol = card.Suit == "Hearts" ? "♥" : card.Suit == "Diamonds" ? "♦" : card.Suit == "Clubs" ? "♣" : "♠";

                                    <div class="playing-card @(isRed ? "red" : "black")">
                                        <div class="fw-bold fs-5 text-start">@card.Rank</div>
                                        <div class="suit-large">@suitSymbol</div>
                                        <div class="fw-bold fs-5 text-end">@card.Rank</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>

    <div class="row justify-content-center mt-4">
        <div class="col-md-8 action-panel text-center">
            <div class="d-flex justify-content-center gap-4">

                @if (!isGameOver)
                {
                    <form asp-controller="BlackJack" asp-action="Hit" method="post" asp-route-id="@Model.GameId">
                        <button type="submit" class="btn btn-warning btn-lg px-4 fw-bold rounded-pill text-dark shadow-sm">
                            💥 Hit
                        </button>
                    </form>

                    <form asp-controller="BlackJack" asp-action="Stand" method="post" asp-route-id="@Model.GameId">
                        <button type="submit" class="btn btn-danger btn-lg px-4 fw-bold rounded-pill shadow-sm">
                            🛑 Stand
                        </button>
                    </form>

                    @if (canSplit)
                    {
                        <form asp-controller="BlackJack" asp-action="Split" method="post" asp-route-id="@Model.GameId">
                            <button type="submit" class="btn btn-info btn-lg px-4 fw-bold rounded-pill text-dark shadow-sm border border-light">
                                ✂️ Split
                            </button>
                        </form>
                    }
                }
                else
                {
                    <form asp-controller="BlackJack" asp-action="Start" method="post">
                        <button type="submit" class="btn btn-success btn-lg px-5 fw-bold rounded-pill shadow-lg border border-light">
                            🔄 Play Again
                        </button>
                    </form>
                }

            </div>
        </div>
    </div>
</div>